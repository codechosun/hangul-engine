# 뒤에 오는 규칙이 이긴다. 넓은 것부터 좁은 것 순으로 적는다.

# 기본: 저장소에는 LF 로 둔다.
* text=auto eol=lf

# 정답표는 줄 끝이 바뀌면 안 된다 (파이썬이 newline="\n" 으로 굽는다).
*.csv text eol=lf

# 배치 파일은 CRLF 로 체크아웃해야 한다.
# LF 만 있으면 cmd 가 레이블과 여러 줄 구문을 제대로 못 읽는다.
*.bat text eol=crlf

# 이진 파일.
*.png binary
*.npy binary
*.bin binary
*.hgen binary
