# 파이썬 가상환경 (tools/ 스크립트 전용)
.venv/

# 내려받은 코퍼스. 1GB 급이고 스크립트로 언제든 다시 만들 수 있다.
data/corpus.txt
data_download.log

# 구워둔 모델. 180MB 급이고 A7 을 한 번 돌리면 다시 만들어진다.
data/*.bin

# 예제가 만들어내는 임시 파일
data/npy_from_cpp.npy
data/npy_big.npy
data/npy_big.csv

# C6 이 만들어내는 것. 예제를 한 번 돌리면 다시 생긴다.
# 그림(.png)은 본문에서 참조하므로 커밋한다.
data/embedding.npy
data/vocab.csv
data/loss_curve.csv

# D7 이 만들어내는 훈련 곡선. 예제를 한 번 돌리면 다시 생긴다.
data/training_curve.csv

# D8 이 만들어내는 그로킹 곡선. 예제를 한 번 돌리면 다시 생긴다.
data/grokking_curve.csv

# E2 가 만들어내는 것. 예제를 한 번 돌리면 다시 생긴다.
data/chat.hgen
data/chat-damaged.hgen

# tools/export_engine.py 가 만드는 배포 폴더.
dist/
data/pca_cpp.csv

# A9 가 쓰는 Kiwi 배포본. 500MB 급이라 커밋하지 않는다.
# tools/get_kiwi.py 로 언제든 다시 받는다.
third_party/

# data/*.csv 정답표는 반드시 커밋한다.
# 독자가 파이썬 없이 검증하려면 이 파일들이 저장소에 있어야 한다.

# MSVC 빌드 산출물
*.obj
*.exe
*.pdb
*.ilk
*.idb
*.user
x64/
Debug/
Release/
.vs/

# 커맨드라인 빌드 산출물
build/
